# Next.js / Supabase Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# localhost以外から開発サーバーへアクセスする場合、許可するホスト名/IPをカンマ区切りで指定します。
ALLOWED_DEV_ORIGINS=
NEXT_PUBLIC_SUPABASE_URL=http://192.168.100.2:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-key

# atsumate専用PostgreSQL。公開ポートはDockge側のPOSTGRES_PORTと合わせます。
DATABASE_URL=postgresql://atsumate:replace-with-db-password@192.168.100.2:5433/atsumate?schema=public

# ゲストトークンのハッシュ化に使用します。
GUEST_TOKEN_PEPPER=replace-with-a-long-random-value

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# FlutterのGoogle IDトークンで許可するAndroid/iOS Client IDをカンマ区切りで指定します。
GOOGLE_ALLOWED_CLIENT_IDS=

# モバイル向けアクセストークンの署名に使用します。AUTH_SECRETとは別の値にしてください。
MOBILE_TOKEN_SECRET=replace-with-another-32-random-characters

# 認証メール
RESEND_API_KEY=
AUTH_EMAIL_FROM=atsumate <auth@example.com>

# localhost以外から開発サーバーへアクセスする場合、許可するホスト名/IPをカンマ区切りで指定します。
ALLOWED_DEV_ORIGINS=

# atsumate専用PostgreSQL。公開ポートはDockge側のPOSTGRES_PORTと合わせます。
DATABASE_URL=postgresql://atsumate:replace-with-db-password@192.168.100.2:5433/atsumate?schema=public

# ゲストトークンのハッシュ化に使用します。他のシークレットとは別の値にしてください。
GUEST_TOKEN_PEPPER=replace-with-a-third-long-random-value

# AI副幹事（langgraph_sample）。AUTH_MODE=disabledの場合、トークンは空欄で利用できます。
AGENT_API_URL=http://localhost:8000
AGENT_API_TOKEN=

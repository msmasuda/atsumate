# Next.js / Auth.js
NEXTAUTH_URL=http://localhost:3000
# localhost以外から開発サーバーへアクセスする場合、許可するホスト名/IPをカンマ区切りで指定します。
ALLOWED_DEV_ORIGINS=
NEXTAUTH_SECRET=replace-with-a-long-random-value
KEYCLOAK_CLIENT_ID=atsumate-web
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
KEYCLOAK_ISSUER=http://192.168.100.2:8080/realms/langgraph

# atsumate専用PostgreSQL。公開ポートはDockge側のPOSTGRES_PORTと合わせます。
DATABASE_URL=postgresql://atsumate:replace-with-db-password@192.168.100.2:5433/atsumate?schema=public

# ゲストトークンのハッシュ化に使用します。NEXTAUTH_SECRETとは別の値にしてください。
GUEST_TOKEN_PEPPER=replace-with-another-long-random-value
